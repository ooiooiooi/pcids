{
  "appId": "com.pcids.win7.private-test",
  "productName": "程控安装部署系统-Win7私有库测试版",
  "electronVersion": "22.3.27",
  "directories": {
    "output": "release-win7-private"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "!node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "backend/dist-win7-web",
      "to": "backend",
      "filter": [
        "pcids_backend.exe"
      ]
    },
    {
      "from": "tools/codearts_release_debugger/browser_runtime",
      "to": "tools/codearts_browser_runtime",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "signAndEditExecutable": false,
    "target": [
      "nsis"
    ],
    "icon": "assets/app-icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "allowElevation": true
  }
}
